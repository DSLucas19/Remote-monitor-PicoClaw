# ──────────────────────────────────────────────
#  Remote Monitor Dashboard — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Server ────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///./dashboard.db

# ── Security (REQUIRED — generate strong values) ──
# Generate JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# JWT session lifetime in minutes
JWT_EXPIRE_MINUTES=120

# Generate INITIAL_ADMIN_KEY:
#   python -c "import secrets; print('rmk_' + secrets.token_urlsafe(32))"
INITIAL_ADMIN_KEY=

# ── CORS ──────────────────────────────────────
# Comma-separated origins. Use "*" for dev only.
CORS_ORIGINS=*

# ── MetaClaw Service ──────────────────────────
METACLAW_WORKDIR=.
METACLAW_COMMAND=py -m metaclaw start
METACLAW_PORT=30000
METACLAW_LOG_FILE=

# ── PicoClaw Service ─────────────────────────
PICOCLAW_WORKDIR=.
PICOCLAW_COMMAND=picoclaw-launcher.exe
PICOCLAW_PORT=18800
PICOCLAW_LOG_FILE=

# ── Gateway Auto-Connect ──────────────────────
GATEWAY_AUTO_CONNECT_ENABLED=true
GATEWAY_URL=
GATEWAY_METHOD=POST
GATEWAY_HEADERS_JSON={}
GATEWAY_BODY_JSON={}
GATEWAY_TIMEOUT_SECONDS=8
GATEWAY_RETRIES=3
GATEWAY_BACKOFF_SECONDS=2
GATEWAY_MIN_INTERVAL_SECONDS=20

# ── Timing ────────────────────────────────────
HEALTH_POLL_SECONDS=2
STARTUP_WAIT_SECONDS=45
STOP_TIMEOUT_SECONDS=8
